# EduTrack public profile (read-only)
# Copy to `.env` / `.env.local`. Also set these on Vercel (Production) and Redeploy.
VITE_EDUTRACK_FUNCTIONS_URL=https://egdjzarvzzxafjdcemyy.supabase.co/functions/v1
VITE_EDUTRACK_ANON_KEY=your_supabase_anon_key
VITE_EDUTRACK_SCHOOL_ID=victoria-crest-international-school

# Admin content management
VITE_CONVEX_URL=https://YOUR_CONVEX_DEPLOYMENT.convex.cloud
# HTTP actions (chat) use the .convex.site host — optional if VITE_CONVEX_URL is set (auto-derived)
VITE_CONVEX_SITE_URL=https://YOUR_CONVEX_DEPLOYMENT.convex.site
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
# Same-origin Clerk Frontend API proxy path (required for this project's live Clerk domain)
VITE_CLERK_PROXY_URL=/__clerk
# Server-only (Vite proxy + Vercel /api/clerk-proxy) — never commit real values
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PROXY_URL=https://vcis-alpha.vercel.app/__clerk

# Convex server environment variables (set with `npx convex env set`, not VITE_)
CLERK_JWT_ISSUER_DOMAIN=https://YOUR_CLERK_INSTANCE.clerk.accounts.dev
ADMIN_EMAILS=admin@example.com
OPENROUTER_API_KEY=your_openrouter_api_key
# Optional EduTrack overrides for the chat action (defaults match website public profile)
# EDUTRACK_FUNCTIONS_URL=https://egdjzarvzzxafjdcemyy.supabase.co/functions/v1
# EDUTRACK_ANON_KEY=
# EDUTRACK_SCHOOL_ID=victoria-crest-international-school
