{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/__clerk", "destination": "/api/clerk-proxy?path=" },
    { "source": "/__clerk/(.*)", "destination": "/api/clerk-proxy?path=$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
